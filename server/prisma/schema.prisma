datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  companies Company[]
}

model Company {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  size        String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       Deal[]
}

model Deal {
  id           String        @id @default(uuid())
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerName String
  value        Float
  currency     String        @default("USD")
  stage        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  interactions Interaction[]
  stakeholders Stakeholder[]
  requirements Requirement[]
  objections   Objection[]
  commitments  Commitment[]
  priorityShifts PriorityShift[]
  risks        Risk[]
  outcomes     Outcome[]
}

model Interaction {
  id               String   @id @default(uuid())
  dealId           String
  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type             String
  content          String
  source           String
  occurredAt       DateTime
  createdAt        DateTime @default(now())
  processingStatus String   @default("pending") // pending, completed, failed
}

model Stakeholder {
  id           String   @id @default(uuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name         String
  role         String
  organization String
  influence    String
  sentiment    String   @default("unknown")
}

model Requirement {
  id          String   @id @default(uuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      String   @default("active")
  firstSeenAt DateTime
  lastSeenAt  DateTime
  evidence    String
}

model Objection {
  id          String   @id @default(uuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  title       String
  description String
  status      String   @default("unresolved")
  firstSeenAt DateTime
  lastSeenAt  DateTime
  evidence    String
}

model Commitment {
  id                  String   @id @default(uuid())
  dealId              String
  deal                Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  action              String
  owner               String
  dueDate             DateTime?
  status              String   @default("Promised")
  sourceInteractionId String
  evidence            String
}

model PriorityShift {
  id           String   @id @default(uuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromPriority String
  toPriority   String
  reason       String   @default("")
  detectedAt   DateTime
  evidence     String
  confidence   String   @default("medium")
}

model Risk {
  id                   String   @id @default(uuid())
  dealId               String
  deal                 Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  category             String
  title                String
  description          String
  severity             String   @default("medium")
  evidence             String
  sourceInteractionIds String   @default("")
  status               String   @default("active")
}

model Outcome {
  id            String   @id @default(uuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type          String
  description   String
  interactionId String
  occurredAt    DateTime
}
